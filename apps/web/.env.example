# Local dev (Neo4j + Postgres already run natively in this workspace)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=networker_dev_pw

DATABASE_URL=postgresql://networker:networker_dev@localhost:5432/networker

# Optional: OpenSearch (skipped silently when unreachable)
OPENSEARCH_URL=http://localhost:9200

# Optional: S3/MinIO for evidence blobs (upload-url returns 503 when unset)
S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=networker-evidence
S3_ACCESS_KEY=networker
S3_SECRET_KEY=networker_dev_minio
S3_REGION=us-east-1

JWT_SECRET=dev-secret-change-me
JWT_EXPIRES_MINUTES=60
